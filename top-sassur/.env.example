# Copier en .env et adapter. Ne jamais committer le vrai .env.

# --- Django ---
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=changez-moi-avec-une-longue-chaine-aleatoire
DJANGO_ALLOWED_HOSTS=*

# Clé de chiffrement des champs sensibles (téléphone patient).
# Générer : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# --- PostgreSQL ---
POSTGRES_DB=topsassur
POSTGRES_USER=topsassur
POSTGRES_PASSWORD=topsassur

# --- Compte administrateur initial ---
DJANGO_ADMIN_USER=admin
DJANGO_ADMIN_PASSWORD=admin1234

# --- CORS (origine du front) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173
