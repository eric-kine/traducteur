# =====================================================================
# Top S'ASSUR — configuration du serveur
# Copiez ce fichier en « .env » et adaptez les valeurs.
# (Les variables ci-dessous se définissent comme variables d'environnement.)
# =====================================================================

# Clé secrète pour signer les jetons de connexion. METTEZ UNE VALEUR ALÉATOIRE
# LONGUE en production (ex. sortie de : python -c "import secrets;print(secrets.token_hex(32))")
SECRET_KEY=changez-moi-par-une-cle-aleatoire-longue

# Compte administrateur (espace admin de l'application)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changez-ce-mot-de-passe

# Supplément pour les soins à domicile (FCFA)
HOME_FEE=3000

# Port d'écoute
PORT=5000

# ---------------------------------------------------------------------
# PAIEMENTS
# ---------------------------------------------------------------------
# Fournisseur : "sandbox" (par défaut, simulation) ou "campay" (paiement réel).
PAYMENT_PROVIDER=sandbox

# --- Campay (Orange Money + MTN Mobile Money au Cameroun) ---
# Créez un compte marchand sur https://campay.net puis renseignez :
# (utilisez d'abord l'environnement DEMO de Campay pour tester)
# CAMPAY_BASE_URL=https://demo.campay.net      # démo Campay
# CAMPAY_BASE_URL=https://api.campay.net       # production Campay
# CAMPAY_USERNAME=votre_app_username
# CAMPAY_PASSWORD=votre_app_password
