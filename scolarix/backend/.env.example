# Copier ce fichier en ".env" puis adapter les valeurs.
NODE_ENV=development
PORT=4000

# Connexion PostgreSQL (docker compose fournit ces identifiants)
DATABASE_URL=postgresql://scolarix:scolarix@localhost:5432/scolarix

# Secret de signature des jetons d'accès : chaîne aléatoire d'au moins 32 caractères.
# Générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=remplacez-moi-par-une-longue-chaine-aleatoire-de-48-caracteres
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Adresse du frontend (CORS)
CORS_ORIGIN=http://localhost:5173

# Compte administrateur créé par "npm run db:seed"
SEED_ADMIN_EMAIL=admin@scolarix.local
SEED_ADMIN_PASSWORD=Admin12345
