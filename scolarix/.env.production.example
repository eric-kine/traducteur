# Copier en .env.production puis remplacer TOUTES les valeurs.
# Ne jamais enregistrer ce fichier rempli dans Git.

# Mot de passe de la base PostgreSQL (long et aléatoire)
POSTGRES_PASSWORD=change-moi-mot-de-passe-base

# Secret de signature des sessions : 48 caractères aléatoires
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-moi-secret-de-48-caracteres-minimum-aleatoires

# Adresse publique du site (sert aux QR codes de vérification et à la sécurité CORS)
PUBLIC_APP_URL=https://scolarix.mon-institut.sn

# Premier compte administrateur (créé au premier démarrage s'il n'existe pas)
SEED_ADMIN_EMAIL=admin@mon-institut.sn
SEED_ADMIN_PASSWORD=change-moi-Admin123

# Port HTTP exposé par le conteneur "web" (derrière votre reverse proxy HTTPS)
HTTP_PORT=8080

# Laisser à true en production (HTTPS). false UNIQUEMENT pour un essai local en http://localhost
COOKIE_SECURE=true
